function audio_biometrics()
% AUDIO_BIOMETRICS  Speaker verification + identification with a named speaker database.
%
%   Workflow
%     1. "+ New speaker"  -> type a name (e.g. Ravi)
%     2. STEP 1: record / load 2 to 5 samples of the SAME phrase for that speaker
%     3. STEP 2: record / load the voice you want to test
%     4. STEP 3: VERIFY  (is it the selected speaker?)  or
%                IDENTIFY (who is it? searches every speaker in the database)
%
%   The database is saved automatically to speaker_db.mat next to this file.

    P.Fs = 16000;   P.frameMs = 25;   P.stepMs = 10;   P.alpha = 0.97;
    P.nFilt = 26;   P.nCoef = 13;     P.NFFT = 512;
    P.maxSec  = 12;
    P.denoise = true;
    P.rasta   = false;
    P.zThr    = 1.0;
    P.fbank   = melFilterBank(P.nFilt, P.NFFT, P.Fs);
    P.dctMat  = dctMatrix(P.nFilt, P.nCoef);
    Fs = P.Fs;

    dbFile = fullfile(dbFolder(), 'speaker_db.mat');
    db = repmat(newSpeaker(''), 0, 1);      % speaker database (struct array)
    testSig = [];  testName = '';
    rec = [];  tmr = [];  recMode = '';  t0 = [];  recSpk = 0;
    BG = [0.97 0.97 0.98];

    fig = figure('Name', 'Audio Biometrics', 'NumberTitle', 'off', ...
        'MenuBar', 'none', 'ToolBar', 'none', 'Color', BG, ...
        'Position', [80 30 1180 780], 'CloseRequestFcn', @onClose);

    % ---------------- title + STOP ----------------
    uicontrol(fig, 'Style', 'text', 'FontSize', 16, 'FontWeight', 'bold', ...
        'String', 'Audio Biometrics  -  speaker verification and identification', ...
        'HorizontalAlignment', 'left', 'BackgroundColor', BG, ...
        'ForegroundColor', [0.10 0.20 0.45], 'Position', [15 745 900 30]);
    btnStop = mkBtn(fig, 'STOP RECORDING', [1000 742 165 34], @(~,~) stopRec());
    set(btnStop, 'Enable', 'off', 'ForegroundColor', [0.8 0 0], 'FontWeight', 'bold', ...
        'BackgroundColor', [1 0.85 0.85]);

    % ---------------- left: speaker database ----------------
    pSpk = mkPanel('Speaker database', [15 90 330 645]);
    lbSpk = uicontrol(pSpk, 'Style', 'listbox', 'FontSize', 12, 'String', {' '}, ...
        'Position', [10 165 308 440], 'Callback', @(~,~) onSelect(), ...
        'TooltipString', 'Click a speaker to select it for enrollment and verification');
    btnAddSpk = mkBtn(pSpk, '+ New speaker', [10 118 100 36], @(~,~) addSpeakerDlg());
    btnRenSpk = mkBtn(pSpk, 'Rename',        [115 118 95 36], @(~,~) renameSpk());
    btnDelSpk = mkBtn(pSpk, 'Delete',        [215 118 93 36], @(~,~) deleteSpk());
    txtSpkInfo = mkTxt(pSpk, [10 8 298 100], '');

    % ---------------- right: waveform ----------------
    axWave = axes('Parent', fig, 'Units', 'pixels', 'Position', [410 625 745 95]);
    hLine = plot(axWave, 0, 0, 'b'); grid(axWave, 'on');
    ylim(axWave, [-1 1]); xlabel(axWave, 'Time (s)'); ylabel(axWave, 'Amplitude');
    title(axWave, 'Waveform (shows live while recording)');

    % ---------------- step 1: enroll ----------------
    pEnr = mkPanel('STEP 1   Enroll the selected speaker  (2 to 5 samples of the SAME short phrase)', [360 495 805 90]);
    btnRecEnr  = mkBtn(pEnr, 'Record sample',          [15 15 190 40], @(~,~) startRec('enroll'));
    btnLoadEnr = mkBtn(pEnr, 'Load file(s)...',        [215 15 190 40], @(~,~) loadEnroll());
    btnClrEnr  = mkBtn(pEnr, 'Clear this speaker''s samples', [415 15 190 40], @(~,~) clearEnroll());
    mkTxt(pEnr, [615 8 180 50], 'Samples are saved to the database automatically.');

    % ---------------- step 2: test ----------------
    pTest = mkPanel('STEP 2   Provide the voice to test', [360 395 805 90]);
    btnRecTest  = mkBtn(pTest, 'Record test voice', [15 15 190 40], @(~,~) startRec('test'));
    btnLoadTest = mkBtn(pTest, 'Load test file...', [215 15 190 40], @(~,~) loadTest());
    txtTest = mkTxt(pTest, [415 8 380 50], 'Test voice: not provided yet');

    % ---------------- step 3: decide ----------------
    pVer = mkPanel('STEP 3   Decide', [360 285 805 100]);
    btnVerify = mkBtn(pVer, 'VERIFY :  is it the selected speaker?', [15 32 385 40], @(~,~) verify());
    set(btnVerify, 'FontSize', 13, 'FontWeight', 'bold', 'BackgroundColor', [0.80 0.92 0.82], ...
        'TooltipString', '1:1 check against the speaker selected in the database');
    btnIdent = mkBtn(pVer, 'IDENTIFY :  who is it?  (search database)', [410 32 385 40], @(~,~) identify());
    set(btnIdent, 'FontSize', 13, 'FontWeight', 'bold', 'BackgroundColor', [0.80 0.88 0.97], ...
        'TooltipString', '1:N search: compares the test voice with every enrolled speaker');
    chkDen = uicontrol(pVer, 'Style', 'checkbox', 'String', 'Noise reduction', 'Value', 1, ...
        'FontSize', 11, 'BackgroundColor', BG, 'Position', [15 4 170 24], 'Callback', @(~,~) onOpt());
    chkRasta = uicontrol(pVer, 'Style', 'checkbox', 'String', 'RASTA filter', 'Value', 0, ...
        'FontSize', 11, 'BackgroundColor', BG, 'Position', [195 4 150 24], 'Callback', @(~,~) onOpt());
    chkDash = uicontrol(pVer, 'Style', 'checkbox', 'String', 'Show analysis dashboard', 'Value', 1, ...
        'FontSize', 11, 'BackgroundColor', BG, 'Position', [355 4 260 24]);

    % ---------------- result ----------------
    pRes = mkPanel('Result', [360 90 805 185]);
    txtResult = uicontrol(pRes, 'Style', 'text', 'FontSize', 15, 'FontWeight', 'bold', ...
        'Position', [10 100 785 62], 'String', 'Result will appear here', ...
        'ForegroundColor', [0.3 0.3 0.3], 'BackgroundColor', [0.90 0.90 0.92]);
    lbRank = uicontrol(pRes, 'Style', 'listbox', 'FontName', 'FixedWidth', 'FontSize', 9, ...
        'Min', 0, 'Max', 2, 'Value', [], 'String', {' '}, 'Position', [10 8 785 88]);

    % ---------------- footer ----------------
    txtGuide = uicontrol(fig, 'Style', 'text', 'FontSize', 12, 'FontWeight', 'bold', ...
        'HorizontalAlignment', 'left', 'BackgroundColor', BG, 'ForegroundColor', [0.05 0.25 0.60], ...
        'Position', [15 50 1150 26], 'String', '');
    uicontrol(fig, 'Style', 'text', 'FontSize', 9, 'HorizontalAlignment', 'left', ...
        'BackgroundColor', BG, 'ForegroundColor', [0.35 0.35 0.35], 'Position', [15 6 1150 40], ...
        'String', ['TIPS: say the same short phrase every time (3 to 5 s), use the same microphone, ' ...
                   'in a quiet room.  Enroll 3 to 5 samples per person.   Database file: ' dbFile]);

    allCtl = [lbSpk btnAddSpk btnRenSpk btnDelSpk btnRecEnr btnLoadEnr btnClrEnr ...
              btnRecTest btnLoadTest btnVerify btnIdent chkDen chkRasta chkDash];

    loadDB();
    refreshList(1);
    refreshStatus();

    % =====================================================================
    %  UI helpers
    % =====================================================================
    function b = mkBtn(par, label, pos, cb)
        b = uicontrol(par, 'Style', 'pushbutton', 'String', label, ...
            'FontSize', 11, 'Position', pos, 'Callback', cb);
    end

    function t = mkTxt(par, pos, str)
        t = uicontrol(par, 'Style', 'text', 'FontSize', 11, 'BackgroundColor', BG, ...
            'HorizontalAlignment', 'left', 'Position', pos, 'String', str);
    end

    function p = mkPanel(ttl, pos)
        p = uipanel(fig, 'Title', ttl, 'FontSize', 11, 'FontWeight', 'bold', ...
            'Units', 'pixels', 'Position', pos, 'BackgroundColor', BG);
    end

    function setIdle(isIdle)
        s = 'off'; if isIdle, s = 'on'; end
        set(allCtl, 'Enable', s);
        if isIdle, set(btnStop, 'Enable', 'off'); else, set(btnStop, 'Enable', 'on'); end
    end

    function setBusy(tf)
        if ~ishandle(fig), return; end
        if tf, set(fig, 'Pointer', 'watch'); else, set(fig, 'Pointer', 'arrow'); end
        drawnow;
    end

    function setResult(lines, state)
        switch state
            case 'ok',   fg = [1 1 1];       bgc = [0.10 0.60 0.20];
            case 'bad',  fg = [1 1 1];       bgc = [0.78 0.12 0.12];
            case 'warn', fg = [1 1 1];       bgc = [0.85 0.50 0.10];
            case 'busy', fg = [0.2 0.2 0.2]; bgc = [1.00 0.95 0.70];
            otherwise,   fg = [0.3 0.3 0.3]; bgc = [0.90 0.90 0.92];
        end
        set(txtResult, 'String', lines, 'ForegroundColor', fg, 'BackgroundColor', bgc);
        drawnow;
    end

    function setRank(lines)
        set(lbRank, 'String', lines, 'Value', [], 'ListboxTop', 1);
    end

    function updateGuide()
        ix = curIdx();
        if ix == 0
            msg = 'NEXT STEP:  click "+ New speaker" and type the person''s name.';
        elseif numel(db(ix).sigs) < 2
            msg = sprintf('NEXT STEP:  enroll %d more sample(s) for "%s" - record or load them (Step 1).', ...
                          2 - numel(db(ix).sigs), db(ix).name);
        elseif isempty(testSig)
            msg = 'NEXT STEP:  provide the test voice (Step 2).';
        else
            msg = sprintf('READY:  press VERIFY (is it "%s"?) or IDENTIFY (who is it?).', db(ix).name);
        end
        set(txtGuide, 'String', msg);
    end

    function refreshList(keepIdx)
        if isempty(db)
            set(lbSpk, 'String', {'(no speakers yet - click "+ New speaker")'}, 'Value', 1);
            return;
        end
        items = cell(numel(db), 1);
        for q = 1:numel(db)
            n = numel(db(q).sigs);
            if n >= 2, tag = sprintf('%d samples', n); else, tag = sprintf('%d sample - needs 2+', n); end
            items{q} = sprintf('%s   (%s)', db(q).name, tag);
        end
        set(lbSpk, 'String', items, 'Value', min(max(keepIdx, 1), numel(db)));
    end

    function refreshStatus()
        ix = curIdx();
        if ix == 0
            set(txtSpkInfo, 'ForegroundColor', 'k', 'String', ...
                {'No speaker selected.', 'Add people to the database with "+ New speaker".'});
            updateGuide();  return;
        end
        n = numel(db(ix).sigs);
        L = {sprintf('Name: %s', db(ix).name), sprintf('Enrollment samples: %d', n)};
        if n > 0, L{end+1} = ['Files: ' strjoin(db(ix).sigNames, ', ')]; end
        fg = 'k';
        if n < 2
            L{end+1} = 'Add at least 2 samples to calibrate the threshold.';
        elseif isempty(db(ix).model)
            L{end+1} = 'Calibration pending ...';
        elseif db(ix).model.warn
            fg = [0.8 0 0];
            L{end+1} = 'WARNING: samples differ a lot. Re-record with the SAME phrase and mic.';
        else
            L{end+1} = sprintf('Calibrated OK (%d pair(s)). Accept if fused z <= %.1f and DTW z <= %.1f', ...
                               size(db(ix).model.pairD, 1), P.zThr, 2*P.zThr);
        end
        L{end+1} = sprintf('Noise reduction: %s    RASTA: %s', ternary(P.denoise, 'on', 'off'), ternary(P.rasta, 'on', 'off'));
        set(txtSpkInfo, 'ForegroundColor', fg, 'String', L);
        updateGuide();
    end

    function ix = curIdx()
        if isempty(db), ix = 0; else, ix = min(max(get(lbSpk, 'Value'), 1), numel(db)); end
    end

    % =====================================================================
    %  Database
    % =====================================================================
    function saveDB()
        try
            dbSave = repmat(struct('name', '', 'sigs', {{}}, 'sigNames', {{}}, 'created', ''), 0, 1);
            for q = 1:numel(db)
                dbSave(q).name     = db(q).name;
                dbSave(q).sigs     = db(q).sigs;
                dbSave(q).sigNames = db(q).sigNames;
                dbSave(q).created  = db(q).created;
            end
            save(dbFile, 'dbSave');
        catch ME
            warndlg(['Could not save the database: ' ME.message], 'Database');
        end
    end

    function loadDB()
        if exist(dbFile, 'file') ~= 2, return; end
        try
            Ld = load(dbFile, 'dbSave');
            for q = 1:numel(Ld.dbSave)
                s = newSpeaker(Ld.dbSave(q).name);
                s.sigs     = Ld.dbSave(q).sigs;
                s.sigNames = Ld.dbSave(q).sigNames;
                s.created  = Ld.dbSave(q).created;
                db(end+1, 1) = s;
            end
        catch ME
            warndlg(['Could not read the saved database: ' ME.message], 'Database');
        end
    end

    function okk = validName(nm, selfIx)
        okk = false;
        if isempty(nm), warndlg('The name cannot be empty.', 'Speaker name'); return; end
        for q = 1:numel(db)
            if q ~= selfIx && strcmpi(db(q).name, nm)
                warndlg(sprintf('A speaker called "%s" already exists.', nm), 'Speaker name'); return;
            end
        end
        okk = true;
    end

    function ix = addSpeakerDlg()
        ix = 0;
        a = inputdlg('Enter the speaker''s name:', 'New speaker', [1 40]);
        if isempty(a), return; end
        nm = strtrim(a{1});  nm = nm(1:min(end, 30));
        if ~validName(nm, 0), return; end
        db(end+1, 1) = newSpeaker(nm);
        saveDB();  refreshList(numel(db));  ix = numel(db);
        setResult({'Result will appear here'}, 'idle');  setRank({' '});
        refreshStatus();
    end

    function renameSpk()
        ix = curIdx();
        if ix == 0, return; end
        a = inputdlg('New name:', 'Rename speaker', [1 40], {db(ix).name});
        if isempty(a), return; end
        nm = strtrim(a{1});  nm = nm(1:min(end, 30));
        if ~validName(nm, ix), return; end
        db(ix).name = nm;
        saveDB();  refreshList(ix);  refreshStatus();
    end

    function deleteSpk()
        ix = curIdx();
        if ix == 0, return; end
        c = questdlg(sprintf('Delete speaker "%s" and all %d enrollment sample(s)?', ...
                     db(ix).name, numel(db(ix).sigs)), 'Delete speaker', 'Delete', 'Cancel', 'Cancel');
        if ~strcmp(c, 'Delete'), return; end
        db(ix) = [];
        saveDB();  refreshList(min(ix, numel(db)));  onSelect();
    end

    function clearEnroll()
        ix = curIdx();
        if ix == 0, return; end
        if isempty(db(ix).sigs), return; end
        c = questdlg(sprintf('Remove all %d sample(s) of "%s"? (the name stays in the database)', ...
                     numel(db(ix).sigs), db(ix).name), 'Clear samples', 'Clear', 'Cancel', 'Cancel');
        if ~strcmp(c, 'Clear'), return; end
        db(ix).sigs = {};  db(ix).sigNames = {};  db(ix).enr = {};  db(ix).model = [];  db(ix).dirty = true;
        saveDB();  refreshList(ix);  refreshStatus();
    end

    function ix = requireSpeaker()
        ix = curIdx();
        if ix == 0, ix = addSpeakerDlg(); end
    end

    function onSelect()
        ix = curIdx();
        setResult({'Result will appear here'}, 'idle');  setRank({' '});
        if ix > 0 && numel(db(ix).sigs) >= 2
            setBusy(true);  ensureReady(ix);  setBusy(false);
        end
        refreshStatus();
    end

    function okk = ensureReady(ix)
        % analyse the speaker's samples and calibrate its threshold (cached until something changes)
        okk = true;
        if ~db(ix).dirty, return; end
        n = numel(db(ix).sigs);
        setResult({sprintf('Analysing "%s"  (%d samples) ...', db(ix).name, n)}, 'busy');
        try
            E = cell(1, n);
            for q = 1:n
                Aq = analyzeVoice(double(db(ix).sigs{q}), P);
                E{q} = struct('F', Aq.F, 'form', Aq.form, 'voice', Aq.voice, 'spec', Aq.spec, 'ltas', Aq.ltas);
            end
            db(ix).enr = E;
            if n >= 2, db(ix).model = buildModel(E, P); else, db(ix).model = []; end
            db(ix).dirty = false;
        catch ME
            okk = false;
            errordlg(ME.message, ['Could not analyse ' db(ix).name]);
        end
        setResult({'Result will appear here'}, 'idle');
    end

    function okk = addEnroll(ix, x, name)
        okk = false;
        x = x(:);  x = x(1 : min(numel(x), round(P.maxSec * Fs)));
        try
            analyzeVoice(x, P);                       % validation only
        catch ME
            errordlg(ME.message, ['Enrollment error: ' name]);  return;
        end
        db(ix).sigs{end+1} = single(x);  db(ix).sigNames{end+1} = name;
        db(ix).enr = {};  db(ix).model = [];  db(ix).dirty = true;
        showWave(x, sprintf('Sample "%s" added to %s  (%.1f s)', name, db(ix).name, numel(x)/Fs), [0 0.55 0]);
        okk = true;
    end

    function commitEnroll(ix)
        saveDB();  refreshList(ix);
        setBusy(true);  ensureReady(ix);  setBusy(false);
        refreshStatus();
    end

    % =====================================================================
    %  Recording / loading
    % =====================================================================
    function startRec(m)
        if strcmp(m, 'enroll')
            recSpk = requireSpeaker();
            if recSpk == 0, return; end
        end
        recMode = m;
        try
            rec = audiorecorder(Fs, 16, 1);
            record(rec);
        catch ME
            errordlg(['Cannot access the microphone: ' ME.message ...
                '  Use the Load buttons instead.'], 'Microphone error');
            return;
        end
        t0 = tic;  setIdle(false);
        set(hLine, 'Color', [0.85 0 0]);
        tmr = timer('ExecutionMode', 'fixedSpacing', 'Period', 0.15, ...
                    'TimerFcn', @(~,~) updateLive());
        start(tmr);
    end

    function updateLive()
        if isempty(rec) || ~isvalid(fig), return; end
        x = getaudiodata(rec);
        if isempty(x), return; end
        n = numel(x);  w = min(n, 5*Fs);  seg = x(end-w+1:end);
        set(hLine, 'XData', ((n-w):(n-1))/Fs, 'YData', seg);
        xlim(axWave, [(n-w)/Fs, max((n-w)/Fs + 5, n/Fs)]);
        m = max(0.05, 1.1*max(abs(seg)));  ylim(axWave, [-m m]);
        if strcmp(recMode, 'enroll') && recSpk > 0
            who = sprintf('enrollment for %s', db(recSpk).name);
        else
            who = 'test voice';
        end
        title(axWave, sprintf('RECORDING %s ...  %.1f s     click STOP when finished', who, toc(t0)), ...
              'Color', [0.85 0 0], 'Interpreter', 'none');
        drawnow limitrate;
    end

    function stopRec()
        if ~isempty(tmr), stop(tmr); delete(tmr); tmr = []; end
        stop(rec);
        x = getaudiodata(rec);
        setIdle(true);
        if numel(x) < 0.5*Fs
            warndlg('Recording too short. Record at least 1 second.'); return;
        end
        if strcmp(recMode, 'enroll')
            if addEnroll(recSpk, x, sprintf('rec#%d', numel(db(recSpk).sigs)+1)), commitEnroll(recSpk); end
        else
            setTest(x, 'recorded');
        end
    end

    function filt = audioFilter()
        filt = {'*.wav;*.mp3;*.m4a;*.mp4;*.aac;*.flac;*.ogg;*.opus;*.wma;*.amr;*.3gp;*.webm', ...
                'All audio files'; '*.*', 'All files'};
    end

    function loadEnroll()
        ix = requireSpeaker();
        if ix == 0, return; end
        [f, p] = uigetfile(audioFilter(), sprintf('Enrollment file(s) for %s (multi-select allowed)', db(ix).name), 'MultiSelect', 'on');
        if isequal(f, 0), return; end
        if ischar(f), f = {f}; end
        added = false;
        setBusy(true);
        for q = 1:numel(f)
            try
                if addEnroll(ix, loadAudio(fullfile(p, f{q}), Fs), f{q}), added = true; end
            catch ME
                errordlg(ME.message, ['Could not read ' f{q}]);
            end
        end
        setBusy(false);
        if added, commitEnroll(ix); end
    end

    function loadTest()
        [f, p] = uigetfile(audioFilter(), 'Select the TEST voice');
        if isequal(f, 0), return; end
        try
            setTest(loadAudio(fullfile(p, f), Fs), f);
        catch ME
            errordlg(ME.message, 'Could not read file');
        end
    end

    function showWave(x, ttl, col)
        x = x(:);  dur = numel(x)/Fs;
        set(hLine, 'XData', (0:numel(x)-1)/Fs, 'YData', x, 'Color', col);
        xlim(axWave, [0 max(dur, 1)]);
        m = max(0.05, 1.1*max(abs(x)));  ylim(axWave, [-m m]);
        title(axWave, ttl, 'Color', col*0.8, 'Interpreter', 'none');
    end

    function setTest(x, name)
        testSig = x(:);  testName = name;
        showWave(testSig, sprintf('Test voice captured (%.1f s)', numel(testSig)/Fs), [0 0.4 0.8]);
        set(txtTest, 'String', sprintf('Test voice:  %s  (%.1f s)  OK', name, numel(testSig)/Fs));
        updateGuide();
    end

    function onOpt()
        P.denoise = logical(get(chkDen, 'Value'));
        P.rasta   = logical(get(chkRasta, 'Value'));
        for q = 1:numel(db)                 % features must be recomputed with the new DSP settings
            db(q).enr = {};  db(q).model = [];  db(q).dirty = true;
        end
        ix = curIdx();
        if ix > 0 && numel(db(ix).sigs) >= 2
            setBusy(true);  ensureReady(ix);  setBusy(false);
        end
        refreshStatus();
    end

    % =====================================================================
    %  Verify (1:1)  and  Identify (1:N)
    % =====================================================================
    function verify()
        ix = curIdx();
        if ix == 0
            warndlg('Create a speaker first (click "+ New speaker") and enroll 2 to 5 samples.', 'Verify'); return;
        end
        if numel(db(ix).sigs) < 2
            warndlg(sprintf('"%s" has only %d sample(s). Enroll at least 2 (Step 1).', db(ix).name, numel(db(ix).sigs)), 'Verify'); return;
        end
        if isempty(testSig)
            warndlg('Provide a test voice first (Step 2).', 'Verify'); return;
        end
        setBusy(true);  guard = onCleanup(@() setBusy(false));
        if ~ensureReady(ix), return; end
        setResult({'Analysing test voice ...'}, 'busy');
        try
            A  = analyzeVoice(testSig, P);
            sc = scoreTest(A, db(ix).model, db(ix).enr);
        catch ME
            setResult({'Result will appear here'}, 'idle');
            errordlg(ME.message, 'Processing error'); return;
        end
        ok   = isMatch(sc, P);
        conf = 100 / (1 + exp(2.5*(sc.fused - P.zThr)));
        nm   = db(ix).name;
        if ok
            setResult({sprintf('MATCH  -  this is %s', nm), ...
                       sprintf('fused z = %.2f     DTW z = %.2f     confidence ~ %.0f %%', sc.fused, sc.z(1), conf)}, 'ok');
        else
            setResult({sprintf('NO MATCH  -  this is NOT %s', nm), ...
                       sprintf('fused z = %.2f     DTW z = %.2f     confidence ~ %.0f %%', sc.fused, sc.z(1), conf)}, 'bad');
        end
        setRank(featureLines(sc, db(ix).model, P));
        printReport(nm, A, sc, db(ix).model, ok, conf, numel(db(ix).enr), P);
        if get(chkDash, 'Value')
            showDashboard(A, sc, ok, conf, db(ix).enr, db(ix).sigNames, nm);
        end
    end

    function identify()
        cand = find(arrayfun(@(s) numel(s.sigs) >= 2, db));
        if isempty(cand)
            warndlg('No speaker has 2 or more enrollment samples yet.', 'Identify'); return;
        end
        if isempty(testSig)
            warndlg('Provide a test voice first (Step 2).', 'Identify'); return;
        end
        setBusy(true);  guard = onCleanup(@() setBusy(false));
        try
            A = analyzeVoice(testSig, P);
        catch ME
            errordlg(ME.message, 'Processing error'); return;
        end
        nC = numel(cand);
        R = nan(nC, 1);  Z1 = nan(nC, 1);  okv = false(nC, 1);  SC = cell(nC, 1);
        for q = 1:nC
            ix = cand(q);
            setResult({sprintf('Comparing with %s  (%d of %d) ...', db(ix).name, q, nC)}, 'busy');
            if ~ensureReady(ix), continue; end
            setResult({sprintf('Comparing with %s  (%d of %d) ...', db(ix).name, q, nC)}, 'busy');
            try
                SC{q}  = scoreTest(A, db(ix).model, db(ix).enr);
                R(q)   = SC{q}.fused;  Z1(q) = SC{q}.z(1);  okv(q) = isMatch(SC{q}, P);
            catch
            end
        end
        valid = find(~isnan(R));
        if isempty(valid)
            setResult({'Could not score any speaker'}, 'idle'); return;
        end
        [~, ord] = sort(R(valid));  ord = valid(ord);
        mIdx = find(okv);
        if ~isempty(mIdx)
            [~, mm] = min(R(mIdx));  best = mIdx(mm);  identified = true;
        else
            best = ord(1);  identified = false;
        end
        bi   = cand(best);  nm = db(bi).name;
        conf = 100 / (1 + exp(2.5*(R(best) - P.zThr)));
        others = setdiff(mIdx, best);
        tight  = ~isempty(others) && (min(R(others)) - R(best)) < 0.25;

        if identified && ~tight
            setResult({sprintf('IDENTIFIED  -  %s', nm), ...
                       sprintf('fused z = %.2f     confidence ~ %.0f %%', R(best), conf)}, 'ok');
        elseif identified
            setResult({sprintf('PROBABLY  %s  -  but another speaker is very close', nm), ...
                       'Record a longer / cleaner test sample to be sure.'}, 'warn');
        else
            setResult({'UNKNOWN SPEAKER  -  nobody in the database matches', ...
                       sprintf('closest was %s   (fused z = %.2f)', nm, R(best))}, 'warn');
        end

        lines = cell(numel(ord) + 1, 1);
        lines{1} = 'Rank  Speaker             fused z   DTW z   verdict';
        for r = 1:numel(ord)
            k = ord(r);  tag = 'no';
            if okv(k), tag = 'MATCH'; end
            lines{r+1} = sprintf('%2d.   %-17s %8.2f %7.2f   %s', r, shortName(db(cand(k)).name, 17), R(k), Z1(k), tag);
        end
        setRank(lines);
        fprintf('\n================ IDENTIFICATION REPORT ================\n');
        fprintf('%s\n', lines{:});
        fprintf('Decision: %s\n=======================================================\n', ...
                ternary(identified, ['IDENTIFIED as ' nm], 'UNKNOWN speaker'));

        if get(chkDash, 'Value')
            showDashboard(A, SC{best}, identified, conf, db(bi).enr, db(bi).sigNames, nm);
        end
    end

